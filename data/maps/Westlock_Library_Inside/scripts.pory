mapscripts Westlock_Library_Inside_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Westlock_Library_Inside_MapScripts_OnTransition
}

script Westlock_Library_Inside_MapScripts_OnTransition {
    if (var(VAR_WESTLOCK_LIBRARY_STATE) == 1) {
        setflag(FLAG_HIDE_PROF_LARCH)
    }
    else
    {
        clearflag(FLAG_HIDE_PROF_LARCH)
        addobject(LOCALID_PROF_LARCH)
    }

    end
}

script Westlock_Library_Inside_EventScripts_MeetProfLarch
{   
    lock

    msgbox(format("This room is far too humid for these books. I can barely make out the text..."), MSGBOX_DEFAULT)
    msgbox(format("...'...un...t...mp...red, no m...rtal ve...l may h...ld the s...cr..d... and the s...lv..r... without fr...ctur..g...'\p"), MSGBOX_DEFAULT)

    playse(SE_PIN)
    applymovement(LOCALID_PROF_LARCH, Common_Movement_ExclamationMark)
    waitmovement(LOCALID_PROF_LARCH)
    delay(60)
    faceplayer
    checkplayergender

    switch(var(VAR_RESULT))
    {
        case 0:
            msgbox(Westlock_Library_Inside_EventScripts_MeetProfLarch_Male, MSGBOX_DEFAULT)
        case 1:
            msgbox(Westlock_Library_Inside_EventScripts_MeetProfLarch_Female, MSGBOX_DEFAULT)
    }
    
    msgbox(format("You do seem familiar...\p"
           "Perhaps a passing resemblance to... "
           "...Erm...\p"
           "Alas, the thought has deserted me.\p"
           "Old age catching up to me, I suppose. "
           "Not quite as sharp as I used to be!\p"
           "Now, before I forget my manners, allow "
           "me to introduce myself.\p"
           "I am Professor Larch, the regional "
           "Pokémon Professor.\p"
           "...\p"
           "Ah! {PLAYER}! Wonderful to meet you!\p"
           "I do recognize you now, your "
           "grandmother and I go back many years."), MSGBOX_DEFAULT)

    msgbox(
    format("I have spent most of my life studying "
    "the Pokémon of this region.\p"
    "You learn to trust what you can observe: "
    "a footprint, a call, the shape of a wing.\p"
    "But every so often, something appears "
    "that does not fit the pages.\p"
    "When that happens, you stop reading "
    "and start listening..."),
    MSGBOX_DEFAULT)

    msgbox(format("Fascinating creatures, aren't they?"), MSGBOX_YESNO)

    if (var(VAR_RESULT) == 1)
    {
        msgbox(format("Correct answer! You and I will get "
               "on famously, I'm sure."), MSGBOX_DEFAULT)
        setflag(FLAG_AGREE_WITH_PROF_LIBRARY)
    }
    else
    {
        msgbox(format("I see. Well, I am sure you will come to "
               "appreciate them in time."), MSGBOX_DEFAULT)
    }

    msgbox(format("Will you allow me to see your Pokémon?"), MSGBOX_YESNO)

    while (var(VAR_RESULT) == 0)
    {
        msgbox(format("I assure you, I have your best "
               "interests in mind.\p"
               "Now please, show me your Pokémon."), MSGBOX_DEFAULT)

        msgbox(format("Will you allow me to see "
               "your Pokémon?"), MSGBOX_YESNO)
    }

    msgbox(format("Gah!"), MSGBOX_DEFAULT)
    msgbox(format("{FONT_NARROW}Your new Pokemon waits patiently. The Professor hovers and fusses over it, but it is absolutely focused on you.{FONT_NORMAL}"), MSGBOX_DEFAULT)

   msgbox(format(
        "Good heavens...\p"
        "{PLAYER}... it's as if it has known you for years.\p"
        "A wild specimen shouldn't yield like this. Not to an untrained hand. It's almost... terrifyingly natural...\p"
        "Wh-where did you say you found this Pokémon?\p"
        "...\p"
        "The canal bank...?\p"
        "..."
        "Wait... this species... this is one of my...?\p"
    ), MSGBOX_DEFAULT)
    closemessage

    playse(SE_PIN)
    applymovement(LOCALID_PROF_LARCH, Common_Movement_ExclamationMark)
    waitmovement(LOCALID_PROF_LARCH)
    delay(30)

  msgbox(format(
        "But that would mean... my satchel!\p"
        "I... I mean to say, I must have left it! Somewhere outside, yes!"
    ), MSGBOX_DEFAULT)
    closemessage

    playse(SE_PIN)
    applymovement(LOCALID_PROF_LARCH, Common_Movement_ExclamationMark)
    waitmovement(LOCALID_PROF_LARCH)
    delay(30)

    msgbox(format(
        "GOODNESS ME, would you look at the time! I must be off, yes, yes, I must be off!\p"
        "I have left some rather... sensitive apparatus unattended, yes!\p"
        "...\p"
        "Keep that Pokémon close, {PLAYER}. Do not let it out of your sight! Although truth be told, I'm not sure you could.\p"
        "Come and visit me at the lab in Alderbrook Town once I have, erm... stabilised my erm, equipment...\p"
        "We have much to discuss...yes...\p"
        "Until then, {PLAYER}, I bid you adieu!"
    ), MSGBOX_DEFAULT)

    call(Westlock_Library_Inside_EventScripts_ProfLarchExit)
    setflag(FLAG_HIDE_PROF_LARCH)
    removeobject(LOCALID_PROF_LARCH)
    setvar(VAR_WESTLOCK_LIBRARY_STATE, 1)

    setvar(VAR_0x8004, QUEST_A_NEW_CHALLENGE)
    setvar(VAR_0x8005, QUEST_A_NEW_CHALLENGE_STAGE_LARCH_POKEDEX)
    special(Quest_SetStage)

    release
}

script Westlock_Library_Inside_EventScripts_ProfLarchExit
{
    specialvar(VAR_RESULT, GetPlayerFacingDirection)

    if(var(VAR_RESULT) == DIR_NORTH)
    {
        applymovement(LOCALID_PROF_LARCH, Movement_Larch_Exit_PlayerNorth)
        waitmovement(LOCALID_PROF_LARCH)
    }
    else
    {
        applymovement(LOCALID_PROF_LARCH, Movement_Larch_Exit_PlayerEastOrWest)
        waitmovement(LOCALID_PROF_LARCH)
    }

    return
}

text Westlock_Library_Inside_EventScripts_MeetProfLarch_Male{
    format(
        "Oh! Hello there young man! You snuck up on me, didn't you?\pMy head was buried in that book."
    )
}

text Westlock_Library_Inside_EventScripts_MeetProfLarch_Female{
    format(
        "Oh! Hello there young lady! You snuck up on me, didn't you?\pMy head was buried in that book."
    )
}

movement Movement_Larch_Exit_PlayerNorth
{
    walk_right * 2
    walk_down
    walk_right * 3
    walk_down * 4
    walk_left
    walk_down * 3
}

movement Movement_Larch_Exit_PlayerEastOrWest
{
    walk_down
    walk_right * 5
    walk_down * 4
    walk_left
    walk_down * 3
}

movement Movement_Larch_LookLeft {
    walk_in_place_left
}

movement Movement_Larch_LookDown {
    walk_in_place_down
}