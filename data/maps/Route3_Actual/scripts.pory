mapscripts Route3_Actual_MapScripts {}

script Route3_Actual_MapScripts_Tim {
    trainerbattle_single(
        TRAINER_ROUTE3_TIM,
    Route3_Actual_MapScripts_Tim_TrainerPreBattle,
    Route3_Actual_MapScripts_Tim_TrainerDefeated
    )

    msgbox(Route3_Actual_MapScripts_Tim_TrainerPostBattle, MSGBOX_AUTOCLOSE)
    end
}

script Route3_Actual_CamperGary {
    trainerbattle_single(
        TRAINER_ROUTE3_CAMPER_GARY,
    Route3_Actual_CamperGary_TrainerPreBattle,
    Route3_Actual_CamperGary_TrainerDefeated
    )

    msgbox(Route3_Actual_CamperGary_TrainerPostBattle, MSGBOX_AUTOCLOSE)
    end
}

script Route3_Actual_LassSara {
    trainerbattle_single(
        TRAINER_ROUTE3_LASS_SARA,
    Route3_Actual_LassSara_TrainerPreBattle,
    Route3_Actual_LassSara_TrainerDefeated
    )

    msgbox(Route3_Actual_LassSara_TrainerPostBattle, MSGBOX_AUTOCLOSE)
    end
}

script Route3_Actual_MapScript_RiverMan {
    lock
    faceplayer()

    if(!flag(FLAG_ROUTE3_RECEIVED_SOOTHE_BELL)) 
    {
        msgbox("My Wanda used to love this spot.\nShe would spend hours here, watching\lthe water flow by...\p", MSGBOX_DEFAULT)
        msgbox("Hold on to those cherished memories,\ndear child. One day it will all make sense.\p", MSGBOX_DEFAULT)

        giveitem(ITEM_SOOTHE_BELL)
        setflag(FLAG_ROUTE3_RECEIVED_SOOTHE_BELL)
    }

    msgbox("Your loved ones, your Pokemon, all are\nfleeting.")
    release
    end
}

script Route3_Actual_SouthWest_Sign {
    msgbox("Weirford Town -->\n<-- Weirford Forest", MSGBOX_SIGN)
}

script Route3_Actual_NorthEast_Sign {
    msgbox("Weirford Town -->\n<-- Weirford Forest", MSGBOX_SIGN)
}

script Route3_Actual_Item_SilverPowder {
    lock
    finditem(ITEM_SILVER_POWDER)
    release
    end
}

text Route3_Actual_LassSara_TrainerPreBattle {
    "STOP RIGHT THERE MISTER!\nThis is MY turf!"
}

text Route3_Actual_LassSara_TrainerDefeated {
    "I'd like more turf..."
}

text Route3_Actual_LassSara_TrainerPostBattle {
    "I found an item hidden here so I claimed\nthe area in case there are more!"
}

text Route3_Actual_CamperGary_TrainerPreBattle {
    "That forest sure is a maze! You gotta\nbe tough to get through!"
}

text Route3_Actual_CamperGary_TrainerDefeated {
    "Yeah you're pretty tough..."
}

text Route3_Actual_CamperGary_TrainerPostBattle {
    "It took me a long time to get through\nthe forest. Did you know there's a\lshortcut back down?"
}

text Route3_Actual_MapScripts_Tim_TrainerPreBattle {
    "Oh FINALLY, someone chooses my side of\nthe path! Let's battle!"
}

text Route3_Actual_MapScripts_Tim_TrainerDefeated {
    "Oh for fu-...\nAll that waiting and THAT happens!"
}

text Route3_Actual_MapScripts_Tim_TrainerPostBattle {
    "I'm still not going to move."
}
