    format(
        "STOP RIGHT THERE MISTER! This is MY turf!"
    )
}

text Route3_Actual_LassSara_TrainerDefeated {
    format(
        "I'd like more turf..."
    )
}

text Route3_Actual_LassSara_TrainerPostBattle {
    format(
        "I found an item hidden here so I claimed the area in case there are more!"
    )
}

