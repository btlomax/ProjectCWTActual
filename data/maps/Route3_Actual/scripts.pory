script Route3_Actual_MapScript_RiverMan {
    lock
    faceplayer()

    if(!flag(FLAG_ROUTE3_RECEIVED_SOOTHE_BELL)) 
    {
        msgbox(format("My Wanda used to love this spot. She would spend hours here, watching the water flow by...\p"), MSGBOX_DEFAULT)
        msgbox(format("Hold on to those cherished memories, dear child. One day it will all make sense.\p"), MSGBOX_DEFAULT)

        giveitem(ITEM_SOOTHE_BELL)
        setflag(FLAG_ROUTE3_RECEIVED_SOOTHE_BELL)
    }

    msgbox(format("Your loved ones, your Pokemon, all are fleeting."))
    release
    end
}

script Route3_Actual_SouthWest_Sign {
    msgbox(format("Weirford Town --> <-- Weirford Forest"), MSGBOX_SIGN)
}

script Route3_Actual_NorthEast_Sign {
    msgbox(format("Weirford Town --> <-- Weirford Forest"), MSGBOX_SIGN)
}

script Route3_Actual_Item_SilverPowder {
    lock
    finditem(ITEM_SILVER_POWDER)
    release
    end
}

