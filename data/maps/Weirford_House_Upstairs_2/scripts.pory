mapscripts Weirford_House_Upstairs_2_MapScripts {}

script Weirford_House_Upstairs_2_GoDownstairs
{
    playse(SE_EXIT)

    warpsilent(MAP_WEIRFORD_HOUSE_2, 8, 2)
    waitstate

    end
}

script Weirford_House_Upstairs_2_First_Clue
{
    lock
    msgbox(format("Dust covers the nightstand, but the wood beneath is scarred with hundreds of tally marks...\pAnd then they stop..."), MSGBOX_DEFAULT)
    setflag(FLAG_WEIRFORD_HOUSE_ALTERED_CLUE_1)

    call(Weirford_House_Upstairs_2_Check_Clues)
    release
}

script Weirford_House_Upstairs_2_Second_Clue
{
    lock

    msgbox(format("Ghostly writing spreads across the pages before your eyes.\p H E - I S - M I N E."), MSGBOX_DEFAULT)
    msgbox(format("The book suddenly snaps shut."), MSGBOX_DEFAULT)
    setflag(FLAG_WEIRFORD_HOUSE_ALTERED_CLUE_2)

    call(Weirford_House_Upstairs_2_Check_Clues)
    release
}

script Weirford_House_Upstairs_2_Check_Clues
{
    if (var(VAR_WEIRFORD_HOUSE_STATE) != 1) {
        return
    }

    if (flag(FLAG_WEIRFORD_HOUSE_ALTERED_CLUE_1) &&
        flag(FLAG_WEIRFORD_HOUSE_ALTERED_CLUE_2))
    {
        msgbox(format("The hairs on your neck stand on end. Suddenly, you realise that you're not alone. Floorboards creak downstairs..."), MSGBOX_DEFAULT)
        setvar(VAR_WEIRFORD_HOUSE_STATE, 2)
        // Trigger music here
    }

}
