mapscripts PlayerHouse_Inside_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: PlayerHouse_Inside_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 0: PlayerHouse_Inside_BirthdayIntro
    ]
}

script PlayerHouse_Inside_OnTransition {
    if (!flag(FLAG_DOWNSTAIRS_FIRST_TIME)) {
        setvar(VAR_TEMP_0, 0)
    }
    else {
        setvar(VAR_TEMP_0, 1)
    }

    end
}

script PlayerHouse_Inside_BirthdayIntro {
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, PlayerHouse_Inside_MoveDown)
    waitmovement
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_WEST)
    turnobject(LOCALID_GRANDMOTHER, DIR_EAST)
    setflag(FLAG_DOWNSTAIRS_FIRST_TIME)
    setvar(VAR_TEMP_0, 1)
    goto(PlayerHouse_Inside_Birthday)
}

script PlayerHouse_Inside_Dinner {
    lockall
    faceplayer
    msgbox("{PLAYER}, just in time!\pCome and sit down.", MSGBOX_DEFAULT)

    hideobjectat(OBJ_EVENT_ID_PLAYER, MAP_PLAYER_HOUSE_INSIDE)
    hideobjectat(LOCALID_GRANDMOTHER, MAP_PLAYER_HOUSE_INSIDE)
    fadescreen(FADE_TO_BLACK)

    setobjectxy(OBJ_EVENT_ID_PLAYER, 5, 4)
    setobjectxy(LOCALID_GRANDMOTHER, 2, 4)
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_WEST)
    turnobject(LOCALID_GRANDMOTHER, DIR_EAST)

    showobjectat(OBJ_EVENT_ID_PLAYER, MAP_PLAYER_HOUSE_INSIDE)
    showobjectat(LOCALID_GRANDMOTHER, MAP_PLAYER_HOUSE_INSIDE)
    fadescreen(FADE_FROM_BLACK)

    msgbox("Happy birthday {PLAYER}!\nMake a wish!\pNow, what have you been up to?", MSGBOX_DEFAULT)
    msgbox("...\p...\pYou found a what?\p...\p...\pYou found a Pokemon?\pLet me see...\p...\pA surprise gift on your birthday no less...\pHmmmm I wonder...", MSGBOX_DEFAULT)
    msgbox("...\pI think you should go and see Professor\nLarch, he's an old friend.\pIf he's not at his lab he'll be in Westlock\nVillage library.\npast Route 1.", MSGBOX_DEFAULT)
    msgbox("He'll be able to tell you more about\nPokemon.\pBe careful in the tall grass,\nwild pokemon are sure to jump out at you!", MSGBOX_DEFAULT)
    msgbox("Come and see me when you've spoken to\nthe Professor, and please,\pdo be careful dear.", MSGBOX_DEFAULT)

    setvar(VAR_ALDERBROOK_TOWN_STATE, 2)
    setvar(VAR_ROUTE1_STATE, 3)
    releaseall
    end
}

script PlayerHouse_Inside_Rhona {
    lock
    faceplayer
    goto(PlayerHouse_Inside_Birthday)
}

script PlayerHouse_Inside_Birthday {
    switch (var(VAR_ALDERBROOK_TOWN_STATE)) {
        case 0:
            msgbox(
                "You're finally up! I was starting to think\n"
                "you'd sleep through your special day!\p"
                "Happy birthday {PLAYER}!\p"
                "I'm just adding the finishing touches\n"
                "to your birthday cake, no peeking!\p"
                "Why don't you go and get some fresh air\n"
                "whilst I finish up in here.\p"
                "Just don't wander too far, okay?",
                MSGBOX_DEFAULT)
            break
        case 1:
            goto(PlayerHouse_Inside_Dinner)
            break
        case 2:
            msgbox("{PLAYER}, go and see Professor Larch in Westlock Village.\pI'm sure he will want to see your new Pokemon!", MSGBOX_DEFAULT)
            break
        case 3:
            goto(PlayerHouse_Inside_GrandmotherAfterPokedex)
        default:
            goto(PlayerHouse_Inside_GrandmotherOfferRest)
    }

    releaseall
    end
}

script PlayerHouse_Inside_GrandmotherAfterPokedex {
    msgbox("{PLAYER}, you're back, good!", MSGBOX_DEFAULT)
    msgbox("...\p", MSGBOX_DEFAULT)

    msgbox(
    "The sun and moon will cross paths...\p"
    "Larch said that to you?\p"
    "...\p"
    "Come here, {PLAYER}. Let me have a look at you.\p"
    "Hmmm...\p"
    "Perhaps I am only seeing what I want to\n"
    "see after all these years.\p"
    "Still... there is a strength in you.\n"
    "A feeling that you are meant to go\l"
    "farther than this little town.\p"
    "...\p"
    "You should take on the League challenge.\n"
    "See the region. Meet its people.\p"
    "Learn what kind of trainer you want to be.\p"
    "...\p"
    "Be careful, {PLAYER}. There are people out\n"
    "there who mean ill to those who are,\n"
    "different.\p"
    "Trust your Pokemon, and trust yourself,\n"
    "and I know you will live up to your\l"
    "potential.\p"
    "You can always come and see me, and tell\n"
    "me ofyour adventures!\p",
    MSGBOX_DEFAULT)

    msgbox("Before you leave, I have something for\n you.", MSGBOX_DEFAULT)
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox("{PLAYER} received the RUNNING SHOES!", MSGBOX_DEFAULT)
    waitfanfare
    setflag(FLAG_RECEIVED_RUNNING_SHOES)
    msgbox("These will allow you to get around\nquicker. Hold B to run!\p", MSGBOX_DEFAULT)
    msgbox("And take these POTIONS, too.\p", MSGBOX_DEFAULT)
    additem(ITEM_POTION, 3)
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox("{PLAYER} received 3 POTIONS!", MSGBOX_DEFAULT)
    waitfanfare
    msgbox("I see it now, the glint in the eyes...\n", MSGBOX_DEFAULT)
    msgbox("So it begins again.\p Walk worthy, {PLAYER}.\p", MSGBOX_DEFAULT)
    msgbox("You can always come home if you need to.\n"
           "I'd be happy to see you and your Pokemon!\p", MSGBOX_DEFAULT)

    setvar(VAR_ALDERBROOK_TOWN_STATE, 4)
    releaseall
    end
}

script PlayerHouse_Inside_GrandmotherOfferRest {
    msgbox("Hello dear, do you and your POKéMON\nneed a rest?", MSGBOX_YESNO)

    if (var(VAR_RESULT) == YES) {
        msgbox("Of course. Make yourselves at home.", MSGBOX_DEFAULT)
        special(HealPlayerParty)
        msgbox("There we are. You and your POKéMON\nlook much better already.", MSGBOX_DEFAULT)
    }
    else {
        msgbox("All right, dear. Take care of yourselves.\n"
               "out there.", MSGBOX_DEFAULT)
    }

    releaseall
    end
}

movement PlayerHouse_Inside_MoveDown {
    walk_down * 2
    face_left
    step_end
}
