mapscripts PlayerHouse_Inside_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: PlayerHouse_Inside_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 0: PlayerHouse_Inside_BirthdayIntro
    ]
}

script PlayerHouse_Inside_OnTransition {
    if (!flag(FLAG_DOWNSTAIRS_FIRST_TIME)) {
        setvar(VAR_TEMP_0, 0)
    }
    else {
        setvar(VAR_TEMP_0, 1)
    }

    end
}

script PlayerHouse_Inside_BirthdayIntro {
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, PlayerHouse_Inside_MoveDown)
    waitmovement
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_WEST)
    turnobject(LOCALID_GRANDMOTHER, DIR_EAST)
    setflag(FLAG_DOWNSTAIRS_FIRST_TIME)
    setvar(VAR_TEMP_0, 1)
    goto(PlayerHouse_Inside_Birthday)
}

script PlayerHouse_Inside_Dinner {
    lockall
    faceplayer
    msgbox(format("{PLAYER}, just in time!\pCome and sit down."), MSGBOX_DEFAULT)

    hideobjectat(OBJ_EVENT_ID_PLAYER, MAP_PLAYER_HOUSE_INSIDE)
    hideobjectat(LOCALID_GRANDMOTHER, MAP_PLAYER_HOUSE_INSIDE)
    fadescreen(FADE_TO_BLACK)

    setobjectxy(OBJ_EVENT_ID_PLAYER, 5, 4)
    setobjectxy(LOCALID_GRANDMOTHER, 2, 4)
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_WEST)
    turnobject(LOCALID_GRANDMOTHER, DIR_EAST)

    showobjectat(OBJ_EVENT_ID_PLAYER, MAP_PLAYER_HOUSE_INSIDE)
    showobjectat(LOCALID_GRANDMOTHER, MAP_PLAYER_HOUSE_INSIDE)
    fadescreen(FADE_FROM_BLACK)

    msgbox(format("Happy birthday {PLAYER}! Make a wish!\pNow, what have you been up to?"), MSGBOX_DEFAULT)
    msgbox(format("...\p...\pYou found a what?\p...\p...\pYou found a Pokemon?\pLet me see...\p...\pA surprise gift on your birthday no less.\pHmmmm I wonder..."), MSGBOX_DEFAULT)
    msgbox(format("...\pI think you should go and see Professor Larch, he's an old friend.\pIf he's not at his lab, he'll be in Westlock Village library, past Route 1."), MSGBOX_DEFAULT)
    msgbox(format("He'll be able to tell you more about Pokemon.\pBe careful in the tall grass, wild Pokémon are sure to jump out at you!"), MSGBOX_DEFAULT)
    msgbox(format("Come and see me when you've spoken to the Professor, and please,\pdo be careful dear."), MSGBOX_DEFAULT)

    setvar(VAR_ALDERBROOK_TOWN_STATE, 2)
    setvar(VAR_ROUTE1_STATE, 3)

    setvar(VAR_0x8004, QUEST_A_NEW_CHALLENGE)
    setvar(VAR_0x8005, QUEST_A_NEW_CHALLENGE_STAGE_TALK_TO_LARCH)
    special(Quest_SetStage)

    releaseall
    end
}

script PlayerHouse_Inside_Rhona {
    lock
    faceplayer
    goto(PlayerHouse_Inside_Birthday)
}

script PlayerHouse_Inside_Birthday {
    switch (var(VAR_ALDERBROOK_TOWN_STATE)) {
        case 0:
            playse(SE_PIN)
            applymovement(LOCALID_GRANDMOTHER, Common_Movement_ExclamationMark)
            waitmovement(LOCALID_GRANDMOTHER)
            
            msgbox(
                format("You're finally up! I was starting to think "
                "you'd sleep through your special day!\p"
                "Happy birthday {PLAYER}!\p"
                "I'm just adding the finishing touches "
                "to your birthday cake, no peeking!\p"
                "Why don't you go and get some fresh air "
                "whilst I finish up in here.\p"
                "Just don't wander too far, okay?"),
                MSGBOX_DEFAULT)
            break
        case 1:
            goto(PlayerHouse_Inside_Dinner)
            break
        case 2:
            msgbox(format("{PLAYER}, go and see Professor Larch in Westlock Village.\pI'm sure he will want to see your new Pokemon!"), MSGBOX_DEFAULT)
            break
        case 3:
            goto(PlayerHouse_Inside_GrandmotherAfterPokedex)
        default:
            goto(PlayerHouse_Inside_GrandmotherOfferRest)
    }

    releaseall
    end
}

script PlayerHouse_Inside_GrandmotherAfterPokedex {
    msgbox(format("{PLAYER}, you're back, good!"), MSGBOX_DEFAULT)
    msgbox(format("...\p"), MSGBOX_DEFAULT)

    msgbox(format(
    "Twenty years...\p"
    "Larch said that to you? Has it truly been that long?\p"
    "...the old ways...\p"
    "...\p"
    "Come here, {PLAYER}. Let me have a look at you.\p"
    "{FONT_NARROW}Rhona grabs you by the shoulders, and her eyes bore into yours, searching for something only she can see. The room seems to close in around you.{FONT_NORMAL}\p"
    "Hmmm...\p"
    "Perhaps I am only seeing what I want to"
    "see, I thought I saw it in Jul-...\p"
    "...\p"
    "No, I shouldn't place the weight of my old ghosts on your shoulders.\p"
    "...\p"
    "{PLAYER}, you should take on the League challenge."
    "See the region. Meet its people.\p"
    "Learn what kind of trainer you want to be.\p"
    "...\p"
    "Be careful, {PLAYER}. There are people out"
    "there who mean ill to those who are,"
    "different.\p"
    "Trust your Pokemon, and trust yourself,"
    "and I know you will live up to your"
    "potential.\p"
    "You can always come and see me, and tell"
    "me of your adventures!\p"),
    MSGBOX_DEFAULT)
    msgbox(format("{FONT_NARROW}Her hands linger on your shoulders, and you feel the weight of her gaze once more. In her eyes, the shadow of old grief gives way to a quiet, fierce strength. With a sigh, she lets go.{FONT_NORMAL}\p"))
    msgbox(format("If this is truly the path that the Fates have laid at your feet, then go with my blessing."))
    msgbox(format("Go back through Westlock to Meadowvale Farm."
    "From there, make your way through the forest and you'll eventually reach Weirford Town. Then, your journey truly begins.\p"), MSGBOX_DEFAULT)

    msgbox(format("Before you leave, I have something for  you."), MSGBOX_DEFAULT)
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox(format("{PLAYER} received the RUNNING SHOES!"), MSGBOX_DEFAULT)
    waitfanfare
    setflag(FLAG_RECEIVED_RUNNING_SHOES)
    msgbox(format("These will allow you to get around quicker. Hold B to run!\p"), MSGBOX_DEFAULT)
    msgbox(format("And take these POTIONS, too.\p"), MSGBOX_DEFAULT)
    additem(ITEM_POTION, 3)
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox(format("{PLAYER} received 3 POTIONS!"), MSGBOX_DEFAULT)
    waitfanfare
    msgbox(format("So it begins again...\p Walk worthy, {PLAYER}.\p"), MSGBOX_DEFAULT)
    msgbox(format(
           "You can always come home if you need to."
           "I'd be happy to see you and your Pokemon!\p"), MSGBOX_DEFAULT)

    setvar(VAR_ALDERBROOK_TOWN_STATE, 4)

    setvar(VAR_0x8004, QUEST_A_NEW_CHALLENGE)
    setvar(VAR_0x8005, QUEST_A_NEW_CHALLENGE_STAGE_BEAT_WEIRFORD_GYM)
    special(Quest_SetStage)
    
    releaseall
    end
}

script PlayerHouse_Inside_GrandmotherOfferRest {
    msgbox(format("Hello dear, do you and your POKéMON need a rest?"), MSGBOX_YESNO)

    if (var(VAR_RESULT) == YES) {
        msgbox(format("Of course. Make yourselves at home."), MSGBOX_DEFAULT)

        special(HealPlayerParty)
        playfanfare(MUS_HEAL)
        waitfanfare
        setrespawn(HEAL_LOCATION_ALDERBROOK_TOWN_PLAYER_HOUSE)

        msgbox(format("There we are. You and your POKéMON look much better already."), MSGBOX_DEFAULT)
    }
    else {
        msgbox(format("All right, dear. Take care of yourselves. "
               "out there."), MSGBOX_DEFAULT)
    }

    releaseall
    end
}

movement PlayerHouse_Inside_MoveDown {
    walk_down * 2
    face_left
    step_end
}
