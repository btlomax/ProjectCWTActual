mapscripts LarchLab_Inside_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: LarchLab_Inside_MapScripts_Transition
}

script LarchLab_Inside_MapScripts_Transition {
   if(var(VAR_WESTLOCK_LIBRARY_STATE) == 0)
   {
        setflag(FLAG_HIDE_PROF_LARCH)
   }
   else
   {
        clearflag(FLAG_HIDE_PROF_LARCH)
        addobject(LOCALID_PROF_LARCH_LAB)
   }
}

script LarchLab_Inside_MapScripts_ProfessorLarch {
    lock
    faceplayer

    if(flag(FLAG_SYS_POKEDEX_GET))
    {
        msgbox("Good luck on your journey, {PLAYER}.", MSGBOX_DEFAULT)
        release
        end
    }

    msgbox(
        "Ah! {PLAYER}, welcome to my humble laboratory!\p"
        "That's Derek over there, he's my\n"
        "assistant.\p"
        "Say hello Derek!\p"
        "Derek: Hello!\p"
        "We're over here, Derek.\p"
        "Derek: Oh...\p"
        "...\p"
        "Ah, he's a good lad.\p"
        "...\p"
        "Now, {PLAYER}. Congratulations on\n"
        "your first Pokémon!\p"
        "A rather unusual first Pokémon, too.\n"
        "You certainly have a talent for finding\l"
        "interesting things.\p"
        "Pokémon are full of surprises. The more\n"
        "you travel, the more you will meet.\p"
        "And unless you have a truly remarkable\n"
        "memory, you will eventually lose track\l"
        "of which one had the ALARMING teeth.\p"
        "That is where this comes in.\p"
        "It is a Pokédex: a small device that\n"
        "records information about the Pokémon\l"
        "you see and catch.\p"
        "Think of it as a field notebook that\n"
        "does all the writing for you.\p",
    MSGBOX_DEFAULT)

    playfanfare(MUS_OBTAIN_ITEM)
    msgbox("{PLAYER} received the POKéDEX!", MSGBOX_DEFAULT)
    waitfanfare
    setflag(FLAG_SYS_POKEDEX_GET)

    msgbox(
        "Use it well, {PLAYER}. And do let me\n"
        "know if you find anything else unusual\l"
        "along that canal.",
    MSGBOX_DEFAULT)

    msgbox(
        "Before you go, take these POKé BALLS.\n"
        "You will need them for your journey.",
    MSGBOX_DEFAULT)
    additem(ITEM_POKE_BALL, 5)
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox("{PLAYER} received 5 POKé BALLS!", MSGBOX_DEFAULT)
    waitfanfare

    msgbox(
        "Now, go and see your grandmother.\p"
        "Tell Rhona that... hmm.\p"
        "Tell her the sun and the moon will soon\n"
        "cross paths.\p"
        "She will know what I mean.\p",
    MSGBOX_DEFAULT)

    setvar(VAR_ALDERBROOK_TOWN_STATE, 3)
   
    release
    end
}

script LarchLab_Inside_MapScripts_WallNote {
    msgbox("Gone to Westlock Village - AOPL", MSGBOX_SIGN)
    end
}

script LarchLab_Inside_MapScripts_ProfessorAide {
    lock
    faceplayer

    if(var(VAR_WESTLOCK_LIBRARY_STATE) == 0) 
    {
        msgbox("Are you looking for the Professor?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) 
        {
        msgbox("I'm afraid he's not here right now.\pHe has been acting a bit strange recently...\nI'm not sure when he'll be back.", MSGBOX_DEFAULT)
        }
        else
        {
        msgbox("Ah, well enjoy your visit to the lab then!", MSGBOX_DEFAULT)
        }
    }
    else 
    {
        msgbox(
            "Hello, I'm the Professor's aide!\p"
            "I mostly help with research, but he\n"
            "has been sending me on a lot of errands\l"
            "lately...I should talk to him about that...\p"
        )
    }
   
    release
    end
}