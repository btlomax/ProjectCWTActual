mapscripts LarchLab_Inside_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: LarchLab_Inside_MapScripts_Transition
}

script LarchLab_Inside_MapScripts_Transition {
   if(var(VAR_WESTLOCK_LIBRARY_STATE) == 0)
   {
        setflag(FLAG_HIDE_PROF_LARCH)
   }
   else
   {
        clearflag(FLAG_HIDE_PROF_LARCH)
        addobject(LOCALID_PROF_LARCH_LAB)
   }
}

script LarchLab_Inside_MapScripts_ProfessorLarch {
    lock
    faceplayer

    if(flag(FLAG_SYS_POKEDEX_GET))
    {
        msgbox("Good luck on your journey, {PLAYER}.", MSGBOX_DEFAULT)
        release
        end
    }

    msgbox(format("Ah! {PLAYER}, welcome to my humble laboratory!"), MSGBOX_DEFAULT)
    msgbox(format("That's Derek over there, he's my assistant.\pSay hello, Derek!"), MSGBOX_DEFAULT)
    msgbox(format("Derek: Hello!"), MSGBOX_DEFAULT)
    msgbox(format("We're over here, Derek."), MSGBOX_DEFAULT)
    msgbox(format("Derek: Oh...\p..."), MSGBOX_DEFAULT)
    
    msgbox(format(
        "...\p"
        "Ah, he's a good lad.\p"
        "...\p"
        "Now, {PLAYER}. Congratulations on your first Pokémon!\p"
        "A rather unusual first Pokémon, too. You certainly have a talent for finding interesting things...\p"
        "Pokémon are full of surprises. The more you travel, the more you will meet, and unless you have a truly remarkable memory, you will eventually lose track of which one had the ALARMING teeth.\p"
        "That is where this comes in.\p"
        "It is a Pokédex: a device that records information about the Pokémon you see and catch.\p"
        "Think of it as a field notebook that does all the writing for you."
    ), MSGBOX_DEFAULT)

    playfanfare(MUS_OBTAIN_ITEM)
    msgbox("{PLAYER} received the POKéDEX!", MSGBOX_DEFAULT)
    waitfanfare
    setflag(FLAG_SYS_POKEDEX_GET)

    msgbox(format("Use it well, {PLAYER}. And do let me know if you find anything else... unusual along that canal."), MSGBOX_DEFAULT)

    msgbox(format("Before you go, take these POKé BALLS. You will need them for your journey."), MSGBOX_DEFAULT)
    additem(ITEM_POKE_BALL, 5)
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox("{PLAYER} received 5 POKé BALLS!", MSGBOX_DEFAULT)
    waitfanfare

    msgbox(format(
        "Now, go and see your grandmother.\p"
        "Tell Rhona that... well, just tell her that twenty years wasn't long enough.."
        "Tell her the old ways are stirring again.\p"
        "She will know what I mean.\p"),
    MSGBOX_DEFAULT)

    setvar(VAR_ALDERBROOK_TOWN_STATE, 3)
   
    release
    end
}

script LarchLab_Inside_MapScripts_WallNote {
    msgbox("Gone to Westlock Village - AOPL", MSGBOX_SIGN)
    end
}

script LarchLab_Inside_MapScripts_ProfessorAide {
    lock
    faceplayer

    if(var(VAR_WESTLOCK_LIBRARY_STATE) == 0) 
    {
        msgbox("Are you looking for the Professor?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) 
        {
        msgbox(format("I'm afraid he's not here right now.\pHe has been acting a bit strange recently... I'm not sure when he'll be back."), MSGBOX_DEFAULT)
        }
        else
        {
        msgbox(format("Ah, well enjoy your visit to the lab then!"), MSGBOX_DEFAULT)
        }
    }
    else 
    {
        msgbox(format(
            "Hello, I'm the Professor's aide!\p"
            "I mostly help with research, but he"
            "has been sending me on a lot of errands"
            "lately...I should talk to him about that...\p"
        ), MSGBOX_DEFAULT)
    }
   
    release
    end
}