mapscripts Weirford_House_2_MapScripts
{
    MAP_SCRIPT_ON_TRANSITION: Weirford_House_2_OnTransition
}

script Weirford_House_2_OnTransition
{
    if (var(VAR_WEIRFORD_HOUSE_STATE) == 2) {
        clearflag(FLAG_HIDE_WEIRFORD_HOUSE_DOWNSTAIRS_TOBY)
        addobject(LOCALID_TOBY)
    }
    else {
        setflag(FLAG_HIDE_WEIRFORD_HOUSE_DOWNSTAIRS_TOBY)
        removeobject(LOCALID_TOBY)
    }

    end
}

script Weirford_House_2_GoUpstairs
{
    playse(SE_EXIT)
    warpsilent(MAP_WEIRFORD_HOUSE_UPSTAIRS_2, 1, 2)
    waitstate
    end
}

script Weirford_House_2_BasementDoorAccess
{
    if(var(VAR_WEIRFORD_HOUSE_STATE) == 3)
    {
        playse(SE_EXIT)
        warpsilent(MAP_WEIRFORD_HOUSE_BASEMENT, 4, 2)
        waitstate
        end
    }

    lock

    msgbox(format("The basement door is locked."), MSGBOX_DEFAULT)
    release
    end
}

script Weirford_House_2_FirstAlteredDownstairsEntry
{
    if (var(VAR_WEIRFORD_HOUSE_STATE) != 1) {
        return
    }

    if (flag(FLAG_WEIRFORD_HOUSE_ALTERED_DOWNSTAIRS_ENTERED)) {
        return
    }

    setflag(FLAG_WEIRFORD_HOUSE_ALTERED_DOWNSTAIRS_ENTERED)
    lock
    msgbox(format("You hear a thud from above. Something heavy has been moving around upstairs."), MSGBOX_DEFAULT)
    release
    return
}

script Weirford_House_2_Toby_Interact
{
    if (var(VAR_WEIRFORD_HOUSE_STATE) != 2) {
        end
    }

    lock
    faceplayer()
    msgbox(format("I feel...cold..."), MSGBOX_DEFAULT)

    setflag(FLAG_HIDE_WEIRFORD_HOUSE_DOWNSTAIRS_TOBY)
    removeobject(LOCALID_TOBY)
    delay(4)

    clearflag(FLAG_HIDE_WEIRFORD_HOUSE_DOWNSTAIRS_TOBY)
    addobject(LOCALID_TOBY)
    delay(4)

    setflag(FLAG_HIDE_WEIRFORD_HOUSE_DOWNSTAIRS_TOBY)
    removeobject(LOCALID_TOBY)
    delay(4)

    clearflag(FLAG_HIDE_WEIRFORD_HOUSE_DOWNSTAIRS_TOBY)
    addobject(LOCALID_TOBY)
    delay(4)

    setflag(FLAG_HIDE_WEIRFORD_HOUSE_DOWNSTAIRS_TOBY)
    removeobject(LOCALID_TOBY)

     setflag(FLAG_HIDE_WEIRFORD_HOUSE_DOWNSTAIRS_TOBY)
    removeobject(LOCALID_TOBY)
    delay(4)

    clearflag(FLAG_HIDE_WEIRFORD_HOUSE_DOWNSTAIRS_TOBY)
    addobject(LOCALID_TOBY)
    delay(4)

    setflag(FLAG_HIDE_WEIRFORD_HOUSE_DOWNSTAIRS_TOBY)
    removeobject(LOCALID_TOBY)
    delay(4)

    clearflag(FLAG_HIDE_WEIRFORD_HOUSE_DOWNSTAIRS_TOBY)
    addobject(LOCALID_TOBY)
    delay(4)

    setflag(FLAG_HIDE_WEIRFORD_HOUSE_DOWNSTAIRS_TOBY)
    removeobject(LOCALID_TOBY)
    release

    setvar(VAR_WEIRFORD_HOUSE_STATE, 3)

    setvar(VAR_0x8004, QUEST_THE_HOUSE_IN_THE_WOODS)
    setvar(VAR_0x8005, QUEST_THE_HOUSE_IN_THE_WOODS_STAGE_CONFRONT)
    special(Quest_SetStage)
    
    playse(SE_CLICK)

    msgbox(format("A door unlocks somewhere nearby."), MSGBOX_DEFAULT)
    release
    end
}
