mapscripts Weirford_Gym_Downstairs_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Weirford_Gym_Downstairs_MapScripts_FirstVisit
}

script Weirford_Gym_Downstairs_MapScripts_FirstVisit
{
    if(flag(FLAG_VISITED_WEIRFORD_GYM))
    {
        clearflag(FLAG_HIDE_WEIRFORD_GYM_MILO)
        addobject(LOCALID_GYMLEADER_MILO)
    }
}

script Weirford_Gym_Downstairs_MapScripts_Tanya
{
    trainerbattle_single(TRAINER_WEIRFORD_GYM_TANYA,
    Weirford_Gym_Downstairs_MapScripts_Tanya_TrainerPreBattle,
    Weirford_Gym_Downstairs_MapScripts_Tanya_TrainerDefeated)

    msgbox(Weirford_Gym_Downstairs_MapScripts_Tanya_TrainerPostBattle, MSGBOX_AUTOCLOSE)
    end
}

script Weirford_Gym_Downstairs_MapScripts_Cal
{
    trainerbattle_single(TRAINER_WEIRFORD_GYM_CAL,
    Weirford_Gym_Downstairs_MapScripts_Cal_TrainerPreBattle,
    Weirford_Gym_Downstairs_MapScripts_Cal_TrainerDefeated)

    msgbox(Weirford_Gym_Downstairs_MapScripts_Cal_TrainerPostBattle, MSGBOX_AUTOCLOSE)
    end
}

text Weirford_Gym_Downstairs_MapScripts_Tanya_TrainerPreBattle
{
    "This Gym has held on for decades,\n"
    "hidden away in the heart of town.\p"
    "Our Pokémon are much the same.\n"
    "They may be small, but good luck getting\l"
    "them to stay down!\p"
}

text Weirford_Gym_Downstairs_MapScripts_Tanya_TrainerDefeated
{
    "Wow I didn't expect you to be so fierce!\p"
}

text Weirford_Gym_Downstairs_MapScripts_Tanya_TrainerPostBattle
{
    "We all use small, scrappy Pokemon that\n"
    "tend to be Normal, Fighting or Dark\l"
    "types. "
}

text Weirford_Gym_Downstairs_MapScripts_Cal_TrainerPreBattle
{
    "Cal: Get ready for a tough fight!\p"
}

text Weirford_Gym_Downstairs_MapScripts_Cal_TrainerDefeated
{
    "Cal: You defeated me...\p"
}

text Weirford_Gym_Downstairs_MapScripts_Cal_TrainerPostBattle
{
    "Cal: That was a challenging battle!\p"
}
