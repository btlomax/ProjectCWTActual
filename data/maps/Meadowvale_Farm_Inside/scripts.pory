mapscripts Meadowvale_Farm_Inside_MapScripts {}

script Meadowvale_Farm_Inside_MapScripts_FarmbossMax {
    lock
    faceplayer

    if (!flag(FLAG_MEADOWVALE_FARM_MAXINTRODUCTION)) {
        msgbox(Meadowvale_Farm_Inside_MapScripts_FarmbossMax_Intro, MSGBOX_DEFAULT)
        setflag(FLAG_MEADOWVALE_FARM_MAXINTRODUCTION)
        setvar(VAR_0x8004, QUEST_MAX_FARM_BOSS)
        special(Quest_Add)
    }

    if (var(VAR_ROUTE2_MEADOWVALE_FARM_STATE) < 4) {
        msgbox(Meadowvale_Farm_Inside_Text_MaxNeedToDefeatChildren, MSGBOX_DEFAULT)
        release
        end
    }

    trainerbattle_single(
        TRAINER_ROUTE2_MEADOWVALEFARM_INSIDE_MAX,
        Meadowvale_Farm_Inside_Text_MaxPreBattle,
        Meadowvale_Farm_Inside_Text_MaxDefeated,
        Meadowvale_Farm_Inside_MapScripts_FarmbossMax_GiveCut
    )

    msgbox(Meadowvale_Farm_Inside_Text_MaxPostBattle, MSGBOX_AUTOCLOSE)
    end
}

script Meadowvale_Farm_Inside_MapScripts_FarmbossMax_GiveCut {
    msgbox(
        format("WOOOOOO I'M PUMPED NOW! "
        "I'm gonna work up a sweat in the fields!\p"
        "Take this HM, my kids can do it the old"
        "fashioned way! HAHAHAHA!\p")
        MSGBOX_DEFAULT
    )
    giveitem(ITEM_HM_CUT)
    setflag(FLAG_RECEIVED_HM_CUT)
    msgbox(
        format("{PLAYER} received HM01 CUT!"),
        MSGBOX_DEFAULT
    )
    msgbox(format("You can use CUT to remove small trees "
        "that block your path.\p"
        "BUT, you will need the Weirford Gym badge "
        "to use it outside of battle...\p")
        MSGBOX_DEFAULT
    )
    msgbox(format("Let me heal your Pokémon for you, it's "
        "still a fair way to Weirford.\p")
        MSGBOX_DEFAULT
    )

    special(HealPlayerParty)
    playfanfare(MUS_HEAL)
    waitfanfare

    msgbox(format("I don't think anyone has taken on the League challenge for a very long time...\p"
           "In fact, I don't even know if it's a gym anymore! But Milo is in there, he'll agree to battle you.\p"
           "Best of luck, BUB!\p")
        MSGBOX_DEFAULT
    )
    release
    end
}

text Meadowvale_Farm_Inside_MapScripts_FarmbossMax_Intro {
    format(
        "Welcome to Meadowvale Farm, where we "
        "grow crops, raise POKéMON, and apparently "
        "collect children.\p"
        "Turns out 'sowing wild oats' is not "
        "just a farming expression.\p"
        "FOUR kids!\p"
        "FOUR!\p"
        "Their mothers have left them with me "
        "and swanned off to parts unknown!\p"
        "So what do I do? I PUT THEM TO WORK!\p"
        "I have them plow the fields, I have them "
        "weed the crops, feed the animals, and I "
        "have them chase off trespassers!\p"
        "They have 'fun' and my farm prospers!\p"
        "Everyone wins! Mostly me.\p"
        "Anyway, you need to defeat all FOUR of my "
        "farmhands if you wanna take a shot at "
        "the CHAMP!\p"
        "I've got a great prize for you if you can "
        "take me down!\p"
    )
}

text Meadowvale_Farm_Inside_Text_MaxNeedToDefeatChildren {
    format(
        "You need to defeat all FOUR of my kids "
        "if you wanna take a shot at the CHAMP!\p"
    )
}

text Meadowvale_Farm_Inside_Text_MaxPreBattle {
    format(
        "You've beaten all of them?\p"
        "...HELL YEAH!\p"
        "Alright, the CHAMP is here! "
        "Let's goooooo!\p"
        "Take me down if you can, BUB!\p"
    )
}

text Meadowvale_Farm_Inside_Text_MaxDefeated {
    format(
        "You beat me? "
        "I can't believe it!\p"
        "...HELL YEAH!\p"
        "You've got some BEANS, kid! "
        "You took me down no sweat!"
    )
}

text Meadowvale_Farm_Inside_Text_MaxPostBattle {
    format(
        "My kids will be all over me for losing now.\p"
        "URRRH!\p"
        "They're gonna be behind the plow for a "
        "week!\p"
        "HAHAHAHAHAHA!\p"
    )
}


