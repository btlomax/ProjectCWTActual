mapscripts Route1_WillbendCanal_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Route1_WillbendCanal_OnTransition
}

script Route1_WillbendCanal_OnTransition 
{
    switch (var(VAR_ROUTE1_STATE))
    {
        case 1:
            setflag(FLAG_HIDE_BRIDGE_NPC_ROUTE1)
            setflag(FLAG_HIDE_ROUTE1_TUTOR)

        case 3:
            setflag(FLAG_HIDE_STARTER_ITEM)
            clearflag(FLAG_HIDE_ROUTE1_TUTOR)
            addobject(LOCALID_ROUTE1_TUTOR)
            setflag(FLAG_HIDE_BRIDGE_NPC_ROUTE1)

        default:
            setflag(FLAG_HIDE_STARTER_ITEM)
            setflag(FLAG_HIDE_ROUTE1_TUTOR)
            setflag(FLAG_HIDE_BRIDGE_NPC_ROUTE1)
    }

    end
}

script Route1_WillbendCanal_MapScripts_LarchTrigger {
    lock

    clearflag(FLAG_HIDE_BRIDGE_NPC_ROUTE1)
    addobject(LOCALID_BRIDGE_NPC_ROUTE1)

    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, Movement_CameraUp)
    waitmovement(0)

    applymovement(LOCALID_BRIDGE_NPC_ROUTE1, Movement_NPCRuns)
    waitmovement(LOCALID_BRIDGE_NPC_ROUTE1)

    msgbox(format("Oh no oh no OH NO! Which way was it?!"), MSGBOX_DEFAULT)
    closemessage

    applymovement(LOCALID_BRIDGE_NPC_ROUTE1, Movement_NPCLookAround)
    waitmovement(LOCALID_BRIDGE_NPC_ROUTE1)

    msgbox(format("Did he say left then left then right?! Or right then left then left?!"), MSGBOX_DEFAULT)
    closemessage

    applymovement(LOCALID_BRIDGE_NPC_ROUTE1, Movement_NPCLookAround)
    waitmovement(LOCALID_BRIDGE_NPC_ROUTE1)

    playse(SE_DINGDONG)

    msgbox(format("Wait, what...?"), MSGBOX_DEFAULT)
    closemessage

    playse(SE_DINGDONG)

    msgbox(format("{FONT_NARROW}The man looks in the bag he's carrying. His eyes widen in shock.{FONT_NORMAL}"), MSGBOX_DEFAULT)
    msgbox(format("OH FRAK, I grabbed the wrong bag! Oh no oh no OH NO!"), MSGBOX_DEFAULT)

    playse(SE_DINGDONG)

    msgbox(format("AHHHH!FRAK THIS, I'M OUTTA HERE!"))
    closemessage

    applymovement(LOCALID_BRIDGE_NPC_ROUTE1, Movement_NPCRunsAway)
    playse(SE_FLEE)
    clearflag(FLAG_HIDE_STARTER_ITEM)
    addobject(LOCALID_STARTER_DROP)
    waitmovement(LOCALID_BRIDGE_NPC_ROUTE1)

    removeobject(LOCALID_BRIDGE_NPC_ROUTE1)
    setflag(FLAG_HIDE_BRIDGE_NPC_ROUTE1)

    applymovement(OBJ_EVENT_ID_CAMERA, Movement_CameraDown)
    waitmovement(0)
    
    special(RemoveCameraObject)

    setvar(VAR_ROUTE1_STATE, 1)
    release
}

script Route1_EventScript_StarterDrop {
    lock
    faceplayer
    msgbox(format("{FONT_NARROW}The bag on the ground is shaking slightly, lit from within by a gently pulsing red light.{FONT_NORMAL}"), MSGBOX_DEFAULT)
    closemessage

    msgbox(format("Take a look inside?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("You decided not to take a look."), MSGBOX_DEFAULT)
        release
        end
    }   
    else {
        msgbox(format("Just a quick peek..."), MSGBOX_DEFAULT)
        fadescreen(FADE_TO_BLACK)
    }

    setflag(FLAG_SYS_POKEMON_GET)
    special(ChooseStarter)
    bufferleadmonspeciesname(STR_VAR_1)
    msgbox(format("You received a {STR_VAR_1}!"), MSGBOX_DEFAULT)
    playfanfare(MUS_OBTAIN_ITEM)
    waitfanfare
    msgbox(format("Do you want to give a nickname to your POKéMON?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        setvar(VAR_0x8004, 0)
        call(Common_EventScript_NameReceivedPartyMon)
    }

    setflag(FLAG_SYS_QUESTS_ENABLED)
    msgbox(format("The quest system is now active!"), MSGBOX_DEFAULT)
    msgbox(format("Press START and select QUESTS to view your current quests."), MSGBOX_DEFAULT)

    setvar(VAR_0x8004, QUEST_A_NEW_CHALLENGE)
    special(Quest_Add)

    removeobject(LOCALID_STARTER_DROP)
    setflag(FLAG_HIDE_STARTER_ITEM)
    setvar(VAR_ALDERBROOK_TOWN_STATE, 1)
    setvar(VAR_ROUTE1_STATE, 2)
    release
    end
}

script Route1_EventScript_TurnAround { 
   
   if(var(VAR_ALDERBROOK_TOWN_STATE) != 2) {
        lock
        bufferstring(STR_VAR_1, "{PLAYER}")
        msgbox(format("{STR_VAR_1}, don't go too far please!"), MSGBOX_DEFAULT)
        applymovement(OBJ_EVENT_ID_PLAYER, Movement_WalkLeftTwoSteps)
        waitmovement(OBJ_EVENT_ID_PLAYER)
        release
        end
    }
}

script Route1_EventScript_Trigger_Tutorial {

    if(var(VAR_ALDERBROOK_TOWN_STATE) == 2 && var(VAR_ROUTE1_STATE) == 3) {
       goto(Route1_EventScript_Catch_Pokemon_Tutorial)
    }
}

script Route1_EventScript_Catch_Pokemon_Tutorial{
    lock
    faceplayer

    playse(SE_PIN)
    applymovement(LOCALID_ROUTE1_TUTOR, Common_Movement_ExclamationMark)
    waitmovement(LOCALID_ROUTE1_TUTOR)

    special(SpawnCameraObject)

    msgbox(format("Hey kid! You look like a new trainer!\pI can see you have a POKéMON with you."), MSGBOX_DEFAULT)
    msgbox(format("Do you know how to catch wild POKéMON?"), MSGBOX_YESNO)

    if (var(VAR_RESULT) == NO) {
        msgbox(format("OK no problem, let me show you how!"), MSGBOX_DEFAULT)
        msgbox(format("First, you need to find a wild POKéMON. You can find them in tall grass."), MSGBOX_DEFAULT)

        applymovement(LOCALID_ROUTE1_TUTOR, Movement_TutorWalkGrassDown)
        applymovement(OBJ_EVENT_ID_CAMERA, Movement_CameraMoveWithTutorDown)
        waitmovement(OBJ_EVENT_ID_CAMERA)
        waitmovement(LOCALID_ROUTE1_TUTOR)
    
        playmoncry(SPECIES_GROWLITHE, CRY_MODE_NORMAL)
        waitmoncry
        msgbox(format("WOOOOAH!"), MSGBOX_DEFAULT)
        special(RemoveCameraObject)

        special(SavePlayerParty)
        special(LoadWallyZigzagoon)
        special(StartWillowbendTutorBattle)
        special(LoadPlayerParty)

        special(SpawnCameraObject)
        applymovement(LOCALID_ROUTE1_TUTOR, Movement_TutorWalkGrassUp)
        applymovement(OBJ_EVENT_ID_CAMERA, Movement_CameraMoveWithTutorUp)
        waitmovement(OBJ_EVENT_ID_CAMERA)
        waitmovement(LOCALID_ROUTE1_TUTOR)

    msgbox(format("See, that wasn't so hard!\pYou can catch wild POKéMON by weakening them in battle and then throwing a POKéBALL at them."), MSGBOX_DEFAULT)
    }
    else {
        msgbox(format("No problem, but let me give you some tips at least."), MSGBOX_DEFAULT)
    }
   
    msgbox(format("Some Pokémon are hard to find, but they are out there!\pListen out for the cries of wild POKéMON, you never know what you might find!"), MSGBOX_DEFAULT)
    msgbox(format("Come to my house on this route after you've caught 15 Pokemon, I'll have a gift ready for you.\p"), MSGBOX_DEFAULT)
    setvar(VAR_0x8004, QUEST_TUTOR_CATCH)
    special(Quest_Add)

    applymovement(LOCALID_ROUTE1_TUTOR, Movement_TutorLeaveScreenRight)
    waitmovement(LOCALID_ROUTE1_TUTOR)

    setflag(FLAG_HIDE_ROUTE1_TUTOR)
    removeobject(LOCALID_ROUTE1_TUTOR)

    special(RemoveCameraObject)
    setvar(VAR_ROUTE1_STATE, 4)
    release
    end
}

script Route1_WillbendCanal_MapScripts_PathSign {
    msgbox(format("Alderbrook Town V Westlock Village -->"), MSGBOX_SIGN)
    end
}

script Route1_WillbendCanal_MapScripts_TutorSign {
    msgbox(format("Free Pokemon! <-- Inside"), MSGBOX_SIGN)
    end
}
#region Movement Data

movement Movement_CameraUp {
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    step_end
}

movement Movement_CameraDown {
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    step_end
}

movement Movement_NPCRuns {
    walk_fast_left * 7
    step_end
}

movement Movement_NPCRunsAway {
    walk_fast_right * 8
    step_end
}

movement Movement_NPCLookAround {
    walk_in_place_faster_up
    delay_16
    walk_in_place_faster_left
    delay_16
    delay_16
    walk_in_place_faster_right
    delay_16
    walk_in_place_faster_up
    delay_16
    walk_in_place_faster_left
    delay_8
    step_end
}

movement Movement_WalkLeftTwoSteps {
    walk_left
    walk_left
    step_end
}

movement Movement_TutorWalkGrassDown{
    walk_right * 2
    walk_down * 4
    delay_16
    walk_in_place_left
    delay_16
    walk_in_place_right * 2
    delay_16
    walk_in_place_left
    step_end
}

movement Movement_TutorWalkGrassUp{
    walk_up * 3
    walk_left * 1
    step_end
}

movement Movement_CameraMoveWithTutorDown{
    walk_down * 4
    step_end
}

movement Movement_CameraMoveWithTutorUp{
    walk_up * 4
    step_end
}

movement Movement_TutorLeaveScreenRight{
    delay_16
    walk_right * 8
    step_end
}
#endregion
