mapscripts Pokemon_Tutor_Inside_MapScripts {}

script Pokemon_Tutor_Inside_MapScripts_Check_Pokemon_Caught 
{
    lock
    faceplayer

    msgbox("Ah hello young trainer! Are you here to\nsee how many Pokémon you've caught so far?", MSGBOX_YESNO)

    if (var(VAR_RESULT) == 0) {
        msgbox("No problem! Come back anytime.", MSGBOX_DEFAULT)
        release
        end
    }

    setvar(VAR_0x8004, 0)
    specialvar(VAR_RESULT, ScriptGetPokedexInfo)
    
    copyvar(VAR_0x8008, VAR_0x8005)
    copyvar(VAR_0x8009, VAR_0x8006)
    copyvar(VAR_0x800A, VAR_RESULT)
    
    buffernumberstring(STR_VAR_1, VAR_0x8008)
    buffernumberstring(STR_VAR_2, VAR_0x8009)

    msgbox("You've seen {STR_VAR_1} Pokémon and\ncaught {STR_VAR_2} Pokémon!\p", MSGBOX_DEFAULT)

    if (!flag(FLAG_TEMP_1)) {
        if (var(VAR_0x8009) >= 15) {
            msgbox("Wonderful! You've reached 15 caught Pokémon!\nHere is your reward!", MSGBOX_DEFAULT)
            call(Pokemon_Tutor_Inside_Script_GiveTier1Reward)
        } else {
            msgbox("Your first goal is to catch 15 Pokémon.\nCome back when you've caught a few more!", MSGBOX_DEFAULT)
        }
    } else {
        msgbox("You've already claimed all of your rewards!\nKeep up the good work!", MSGBOX_DEFAULT)
    }

    release
    end
}

script Pokemon_Tutor_Inside_Script_GiveTier1Reward {
    givemon(SPECIES_GROWLITHE, 5, ITEM_NONE)
    call(Pokemon_Tutor_Inside_Script_HandleGiftResult)
    if (var(VAR_RESULT) != MON_CANT_GIVE) {
        setflag(FLAG_TEMP_1)
    }
    return
}

script Pokemon_Tutor_Inside_Script_GiveTier2Reward {
    givemon(SPECIES_EEVEE, 10, ITEM_NONE)
    call(Pokemon_Tutor_Inside_Script_HandleGiftResult)
    if (var(VAR_RESULT) != MON_CANT_GIVE) {
        setflag(FLAG_TEMP_2)
    }
    return
}

script Pokemon_Tutor_Inside_Script_GiveTier3Reward {
    givemon(SPECIES_DRATINI, 15, ITEM_NONE)
    call(Pokemon_Tutor_Inside_Script_HandleGiftResult)
    if (var(VAR_RESULT) != MON_CANT_GIVE) {
        setflag(FLAG_TEMP_3)
    }
    return
}

script Pokemon_Tutor_Inside_Script_HandleGiftResult {
    if (var(VAR_RESULT) == MON_GIVEN_TO_PARTY || var(VAR_RESULT) == MON_GIVEN_TO_PC) {
        playfanfare(MUS_OBTAIN_ITEM)
        msgbox("{PLAYER} received the Pokémon!", MSGBOX_DEFAULT)
        waitfanfare
    } else {
        msgbox("Your party and PC are full! Make room and return.", MSGBOX_DEFAULT)
    }
    return
}