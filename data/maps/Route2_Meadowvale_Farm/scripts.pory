movement Route2_Meadowvale_Farm_Movement_ReturnToWestlock {
    walk_left * 2
    step_end
}

text Route2_Meadowvale_Farm_MapScripts_FarmhandTommy_TrainerPreBattle {
    "H-hey! You look like a trainer!\nI-I challenge you to a b-battle!"
}

text Route2_Meadowvale_Farm_MapScripts_FarmhandTommy_TrainerDefeated {
    "Dad told us to battle trainers if we\nsaw any..."
}

text Route2_Meadowvale_Farm_MapScripts_FarmhandTommy_TrainerPostBattle {
    "The farm is up the route, past the fields.\nYou should go check it out!"
}

text Route2_Meadowvale_Farm_MapScripts_FarmhandGeorge_TrainerPreBattle {
    "Hey! You! I'm bored, let's battle!"
}

text Route2_Meadowvale_Farm_MapScripts_FarmhandGeorge_TrainerDefeated {
    "Ugh, now and I'm bored AND I have to go\nback to work..."
}

text Route2_Meadowvale_Farm_MapScripts_FarmhandGeorge_TrainerPostBattle {
    "Farms are so boring, at least there are\nPokemon to find."
}

text Route2_Meadowvale_Farm_MapScripts_FarmhandJenny_TrainerPreBattle {
    "Haha I got you! Now we have to battle!\nYay!"
}

text Route2_Meadowvale_Farm_MapScripts_FarmhandJenny_TrainerDefeated {
    "Nooooooo! I'm telling my dad about you!"
}

text Route2_Meadowvale_Farm_MapScripts_FarmhandJenny_TrainerPostBattle {
    "I don't like you anymore!\nI'm going to tell my dad about you!"
}

text Route2_Meadowvale_Farm_MapScripts_FarmhandLucy_TrainerPreBattle {
    "I'm the oldest, I bet you can't beat me!"
}

text Route2_Meadowvale_Farm_MapScripts_FarmhandLucy_TrainerDefeated {
    "My dad will want to speak to you..."
}

text Route2_Meadowvale_Farm_MapScripts_FarmhandLucy_TrainerPostBattle {
    "My little sister likes to hide in long\ngrass and scare people."
}