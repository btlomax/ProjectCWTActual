mapscripts Route2_Meadowvale_Farm_MapScripts {}

script Route2_Meadowvale_Farm_MapScripts_Route2Sign {
    msgbox(format("Meadowvale Farm -> Weirford Forest"), MSGBOX_SIGN)
    end
}

script Route2_Meadowvale_Farm_MapScripts_FarmSign {
    msgbox(format("Meadowvale Farm Please come in!"), MSGBOX_SIGN)
    end
}

script Route2_Meadowvale_Farm_MapScripts_ForestSign {
    msgbox(format("Entering Weirford Forest "
            "Ensure you're prepared!"),
    MSGBOX_SIGN)
    end
}

script Route2_Meadowvale_Farm_MapScripts_FarmhandTommy {
    trainerbattle_single(TRAINER_ROUTE2_MEADOWVALE_TOMMY,
    Route2_Meadowvale_Farm_MapScripts_FarmhandTommy_TrainerPreBattle,
    Route2_Meadowvale_Farm_MapScripts_FarmhandTommy_TrainerDefeated,
    Route2_Meadowvale_Farm_MapScripts_FarmhandTommy_Beaten
    )

    msgbox(Route2_Meadowvale_Farm_MapScripts_FarmhandTommy_TrainerPostBattle, MSGBOX_AUTOCLOSE)
    end
}

script Route2_Meadowvale_Farm_MapScripts_FarmhandTommy_Beaten {
    addvar(VAR_ROUTE2_MEADOWVALE_FARM_STATE, 1)
    msgbox(Route2_Meadowvale_Farm_MapScripts_FarmhandTommy_TrainerPostBattle, MSGBOX_AUTOCLOSE)
    end
}

