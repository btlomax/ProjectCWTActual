mapscripts Weirford_House_Basement_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Weirford_House_Basement_OnTransition
}

script Weirford_House_Basement_OnTransition
{
    if (var(VAR_WEIRFORD_HOUSE_STATE) == 4) {
        setflag(FLAG_HIDE_WEIRFORD_HOUSE_TOBY)
        removeobject(LOCALID_TOBY)
    }

    end
}

script Weirford_House_Basement_ShuppetBoss
{
    lockall

    if (var(VAR_WEIRFORD_HOUSE_STATE) == 4) {
        releaseall
        end
    }

    playmoncry(SPECIES_SHUPPET, CRY_MODE_NORMAL)
    waitmoncry()
    setvar(VAR_0x8004, SCRIPTED_BOSS_WEIRFORD_HOUSE_SHUPPET)
    special(StartScriptedBossBattle)

    if (var(VAR_RESULT) != B_OUTCOME_WON) {
        releaseall
        end
    }

    msgbox(format(
        "SHUPPET begins to retreat!"),
        MSGBOX_DEFAULT
    )

    playmoncry(SPECIES_SHUPPET, CRY_MODE_NORMAL)
    waitmoncry()

    msgbox(format("But Toby is fading away. You need to act quickly!"))

    if (flag(FLAG_FOUND_LOST_DOLL))
    {
        call(Weirford_House_Basement_LostDollResolution)
    }
    else
    {
         msgbox("What will you do?", MSGBOX_DEFAULT)
        multichoice(17, 6, MULTI_WEIRFORD_HOUSE_DECISION, TRUE)

        if (var(VAR_RESULT) == 0) {
            setflag(FLAG_WEIRFORD_HOUSE_CHOSE_SHUPPET)
            givemon(SPECIES_SHUPPET, 16, ITEM_SPELL_TAG, ITEM_DUSK_BALL, NATURE_ADAMANT, 2, FEMALE,
            0, 0, 0, 0, 0, 0, 31, 18, 20, 20, 15, 31, MOVE_SHADOW_SNEAK, MOVE_WILL_O_WISP, MOVE_GRUDGE, MOVE_ASTONISH)

            msgbox("SHUPPET settles into its Poké Ball.", MSGBOX_DEFAULT)
            msgbox(format("A sudden, cold silence fills the room.\pTOBY's arm drops to the floor."), MSGBOX_DEFAULT)

            subvar(VAR_PLAYER_MORALITY, 5)
            msgbox("The world seems a little darker.", MSGBOX_DEFAULT)
        }
        else
        {
            msgbox("You grab TOBY by the arm.", MSGBOX_DEFAULT)
            playse(SE_FLEE)
            msgbox("SHUPPET vanishes into the shadows.", MSGBOX_DEFAULT)
            msgbox(format("TOBY collapses into your arms, breathing weakly but alive."), MSGBOX_DEFAULT)

            addvar(VAR_PLAYER_MORALITY, 5)
            msgbox("The world seems a little brighter.", MSGBOX_DEFAULT)
    }

    setflag(FLAG_HIDE_WEIRFORD_HOUSE_TOBY)
    clearflag(FLAG_WEIRFORD_HOUSE_DOOR_SEALED)
    setvar(VAR_WEIRFORD_HOUSE_STATE, 4)
    releaseall
    end
    }

    msgbox("What will you do?", MSGBOX_DEFAULT)
    multichoice(17, 6, MULTI_WEIRFORD_HOUSE_DECISION, TRUE)

    if (var(VAR_RESULT) == 0) {
        setflag(FLAG_WEIRFORD_HOUSE_CHOSE_SHUPPET)
        givemon(SPECIES_SHUPPET, 16, ITEM_SPELL_TAG, ITEM_DUSK_BALL, NATURE_ADAMANT, 2, FEMALE,
         0, 0, 0, 0, 0, 0, 31, 18, 20, 20, 15, 31, MOVE_SHADOW_SNEAK, MOVE_WILL_O_WISP, MOVE_GRUDGE, MOVE_ASTONISH)

        msgbox("SHUPPET settles into its Poké Ball.", MSGBOX_DEFAULT)
        msgbox(format("A sudden, cold silence fills the room.\pTOBY's arm drops to the floor."), MSGBOX_DEFAULT)

        subvar(VAR_PLAYER_MORALITY, 5)
        msgbox("The world seems a little darker.", MSGBOX_DEFAULT)
    }
    else {
        msgbox("You grab TOBY by the arm.", MSGBOX_DEFAULT)
        playse(SE_FLEE)
        msgbox("SHUPPET vanishes into the shadows.", MSGBOX_DEFAULT)
        msgbox(format("TOBY collapses into your arms, breathing weakly but alive."), MSGBOX_DEFAULT)

        addvar(VAR_PLAYER_MORALITY, 5)
        msgbox("The world seems a little brighter.", MSGBOX_DEFAULT)
    }

    setflag(FLAG_HIDE_WEIRFORD_HOUSE_TOBY)
    clearflag(FLAG_WEIRFORD_HOUSE_DOOR_SEALED)
    setvar(VAR_WEIRFORD_HOUSE_STATE, 4)
    releaseall
    end
}

script Weirford_House_Basement_LostDollResolution
{
    return
}

script Weirford_House_Basement_Stairs
{
    playse(SE_EXIT)
    warpsilent(MAP_WEIRFORD_HOUSE, 13, 2)
    waitstate
    end
}
