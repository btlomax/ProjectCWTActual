mapscripts Weirford_Gym_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Weirford_Gym_MapScripts_FirstEntry
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 0: Weirford_Gym_MapScripts_FirstEntryScene
    ]
}

script Weirford_Gym_MapScripts_FirstEntry
{
    if (flag(FLAG_VISITED_WEIRFORD_GYM))
    {
        setflag(FLAG_HIDE_WEIRFORD_GYM_MILO)
        setvar(VAR_TEMP_0, 1)
    }
    else
    {
        clearflag(FLAG_HIDE_WEIRFORD_GYM_MILO)
        addobject(LOCALID_GYMLEADER_MILO)
        setvar(VAR_TEMP_0, 0)
    }

    end
}

script Weirford_Gym_MapScripts_FirstEntryScene
{
    lock
    call(Weirford_Gym_MapScripts_MiloInteraction)

    setflag(FLAG_VISITED_WEIRFORD_GYM)
    setvar(VAR_TEMP_0, 1)

    release
    end
}

script Weirford_Gym_MapScripts_MiloInteraction
{
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, Movement_CameraMoveUp)
    waitmovement(OBJ_EVENT_ID_CAMERA)
    delay(30)

    playse(SE_PIN)
    applymovement(LOCALID_GYMLEADER_MILO, Common_Movement_ExclamationMark)
    waitmovement(LOCALID_GYMLEADER_MILO)

    msgbox("Hello? Can I help you?\p", MSGBOX_DEFAULT)
    applymovement(OBJ_EVENT_ID_PLAYER, Weirford_Gym_PlayerMoveUp)
    applymovement(OBJ_EVENT_ID_CAMERA, Movement_CameraMoveUp)
    waitmovement(OBJ_EVENT_ID_CAMERA)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    delay(30)
    applymovement(LOCALID_GYMLEADER_MILO, Movement_MiloFaceDown)
    msgbox("You're here for the what?\n"
    "The Gym Challenge?\p"
    "And you-you're serious?\p"
    "...\p"
    "Errrr...well I gue-", MSGBOX_DEFAULT)
    playse(SE_PIN)
    applymovement(LOCALID_GYMLEADER_MILO, Common_Movement_ExclamationMark)
    waitmovement(LOCALID_GYMLEADER_MILO)
    delay(30)
    msgbox(format(
        "Hold still a moment, trainer.\p"
        "Let me look at you properly...\p"
        "Interesting...\p"
        "In that case, allow me to see if you are prepared for battle.\p"
        "Hmmm...\p"
        "Your gear suggests experience you should not yet possess...\p"
        "Who showed you how to arrange your Poké Balls like that?\p"
        "...\p"
        "It just seemed appropriate, you say?\p"
        "...\p"
        "It comes naturally to you, doesn't it?\p"
        "Fascinating...\p"
        "You don't even realize what you're doing, do you?\p"
        "...\p"
        "Right. Well. That is slightly terrifying."
    ))

   msgbox(format(
    "...\p"
    "Forgive me. Being keeper of this Gym and its badge was a duty passed down to me by my father, as it was by his mother before him...\p"
    "Truth be told, no one has stood at the threshold of this house to challenge us in hundreds of years.\p"
    "I suppose I grew comfortable believing it was just an old family story.\p"
    "Which brings us to the present problem: you have caught me in a state of severe unreadiness.\p"
    "Please go out and come back in again.\p"
    "Literally just do that.\p"
    "I need to summon the trainers, move my ironing board, put away my lunch, blow the dust off the official arena mat, and basically de-mothball the ancient League testing ground in the basement.\p"
    "...\p"
    "I...truly never thought I would be the one to defend this gym...\p"
    "Be ready, Trainer. Hundreds of years or not, we won't go down easily."
), MSGBOX_DEFAULT)

    special(RemoveCameraObject)
}

script Weirford_Gym_MapScripts_MiloAfterFirstEntry
{
    lock
    faceplayer

    msgbox("To dust off the old cobwebs, I feel the\n"
    "fighting spirit stir within.\p"
    "It has been a many a generation since\n"
    "someone like you, has appeared.\p"
    "The others and I have waited, passing\n"
    "the mantle from one generation to the\l"
    "next, until one of the bloodlines\l"
    "surfaced again. Yet, you carry no Crest.\p"
    "...\p"
    "It is no matter, battle will reveal to us\n"
    "the truth.\p", MSGBOX_DEFAULT)

    release
    end
}

movement Weirford_Gym_PlayerMoveUp
{
    walk_up
    walk_right * 3
    walk_up * 2
    step_end
}

movement Movement_CameraMoveUp
{
    walk_up * 2
    walk_right * 2
    step_end
}

movement Movement_MiloFaceDown
{
    face_down
    step_end
}
