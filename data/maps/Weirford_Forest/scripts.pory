script Weirford_Forest_MapScripts_FirstItem {
    lock
    finditem(ITEM_NET_BALL)
    release
    end
}

script Weirford_Forest_MapScripts_SecondItem {
    lock
    finditem(ITEM_ANTIDOTE)
    release
    end
}

script Weirford_Forest_MapScripts_ThirdItem_TM {
    lock
    finditem(ITEM_TM01)
    release
    end
}

script Weirford_Forest_MapScripts_Entrance_Sign {
    msgbox("Weirford Forest", MSGBOX_SIGN)
    end
}

script Weirford_Forest_MapScripts_Exit_Sign {
    msgbox("<- Route 3", MSGBOX_SIGN)
    end
}

script Weirford_Forest_MapScripts_Weirford_House {
    msgbox("Welcome to Weirford House", MSGBOX_SIGN)
    end
}


text Weirford_Forest_MapScripts_CorpoEric_TrainerPreBattle {
    "AH! Where did you come from?!"
}

text Weirford_Forest_MapScripts_CorpoEric_TrainerPostBattle {
    "I'm hiding from my manager..."
}

text Weirford_Forest_MapScripts_CorpoEric_TrainerDefeated {
    "I only lost because you scared me!"
}

text Weirford_Forest_MapScripts_LassLila_TrainerPreBattle {
    "I'll tell you a secret if you\ncan beat me!"
}

text Weirford_Forest_MapScripts_LassLila_TrainerPostBattle {
    "There's a house hidden deep in the forest."
}

text Weirford_Forest_MapScripts_LassLila_TrainerDefeated {
    "UH! FINE I'LL TELL YOU!"
}

text Weirford_Forest_MapScripts_AcolyteLin_TrainerPreBattle {
    "Halt young trainer, allow me to test your\nprowess!"
}

text Weirford_Forest_MapScripts_AcolyteLin_TrainerPostBattle {
    "The Weirford convent must hear of this."
}

text Weirford_Forest_MapScripts_AcolyteLin_TrainerDefeated {
    "Yes, there is power in you..."
    
}

text Weirford_Forest_MapScripts_CamperColin_TrainerPreBattle {
    "This is my first time camping in the\nforest!"
}

text Weirford_Forest_MapScripts_CamperColin_TrainerPostBattle {
    "The camping is NOT going well..."
}

text Weirford_Forest_MapScripts_CamperColin_TrainerDefeated {
    "I'm trying my best not to SHAKE with\nFEAR."
}

text Weirford_Forest_MapScripts_BugCatcherSam_TrainerPreBattle {
    "Have you got any Bug Pokémon?"
}

text Weirford_Forest_MapScripts_BugCatcherSam_TrainerPostBattle {
    "There are bug Pokemon here...\nI can feel them crawling up my OH SHI-\p"
}

text Weirford_Forest_MapScripts_BugCatcherSam_TrainerDefeated {
    "I can't believe you beat my team of\nalmighty bugs!"
}