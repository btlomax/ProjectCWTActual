mapscripts Weirford_Forest_MapScripts
{
    MAP_SCRIPT_ON_TRANSITION: Weirford_Forest_MapScripts_OnTransition
}

script Weirford_Forest_MapScripts_OnTransition
{
    if (flag(FLAG_HIDE_WEIRFORD_FOREST_ACOLYTE_LIN))
    {
        removeobject(LOCALID_WEIRFORD_FOREST_ACOLYTE_LIN)
    }
    else
    {
        addobject(LOCALID_WEIRFORD_FOREST_ACOLYTE_LIN)
    }

    end
}

script Weirford_Forest_MapScripts_BugCatcherSam {
    trainerbattle_single(TRAINER_WEIRFORDFOREST_BUGCATCHER_SAM,
    Weirford_Forest_MapScripts_BugCatcherSam_TrainerPreBattle,
    Weirford_Forest_MapScripts_BugCatcherSam_TrainerDefeated
    )

    msgbox(Weirford_Forest_MapScripts_BugCatcherSam_TrainerPostBattle, MSGBOX_AUTOCLOSE)
    end
}

script Weirford_Forest_MapScripts_CamperColin {
    trainerbattle_single(TRAINER_WEIRFORDFOREST_CAMPER_COLIN,
    Weirford_Forest_MapScripts_CamperColin_TrainerPreBattle,
    Weirford_Forest_MapScripts_CamperColin_TrainerDefeated
    )

    msgbox(Weirford_Forest_MapScripts_CamperColin_TrainerPostBattle, MSGBOX_AUTOCLOSE)
    end
}

script Weirford_Forest_MapScripts_AcolyteLin {
    trainerbattle_single(TRAINER_WEIRFORDFOREST_ACOLYTE_LIN,
    Weirford_Forest_MapScripts_AcolyteLin_TrainerPreBattle,
    Weirford_Forest_MapScripts_AcolyteLin_TrainerDefeated,
    Weirford_Forest_MapScripts_AcolyteLin_AfterBattle
    )

    end
}

script Weirford_Forest_MapScripts_AcolyteLin_AfterBattle
{
    lock

    msgbox(Weirford_Forest_MapScripts_AcolyteLin_TrainerPostBattle, MSGBOX_AUTOCLOSE)

    applymovement(LOCALID_WEIRFORD_FOREST_ACOLYTE_LIN, Weirford_Forest_MapScripts_AcolyteLin_Leave)
    waitmovement(LOCALID_WEIRFORD_FOREST_ACOLYTE_LIN)
    setflag(FLAG_HIDE_WEIRFORD_FOREST_ACOLYTE_LIN)
    removeobject(LOCALID_WEIRFORD_FOREST_ACOLYTE_LIN)
    
    release
    end
}

script Weirford_Forest_MapScripts_CorpoEric{
    trainerbattle_single(TRAINER_WEIRFORDFOREST_CORPO_ERIC,
    Weirford_Forest_MapScripts_CorpoEric_TrainerPreBattle,
    Weirford_Forest_MapScripts_CorpoEric_TrainerDefeated
    )

    msgbox(Weirford_Forest_MapScripts_CorpoEric_TrainerPostBattle, MSGBOX_AUTOCLOSE)
    end
}

script Weirford_Forest_MapScripts_LassLila {
    trainerbattle_single(TRAINER_WEIRFORDFOREST_LASS_LILA,
    Weirford_Forest_MapScripts_LassLila_TrainerPreBattle,
    Weirford_Forest_MapScripts_LassLila_TrainerDefeated
    )

    msgbox(Weirford_Forest_MapScripts_LassLila_TrainerPostBattle, MSGBOX_AUTOCLOSE)
    end
}


script Weirford_Forest_MapScripts_FirstItem {
    lock
    finditem(ITEM_NET_BALL)
    release
    end
}

script Weirford_Forest_MapScripts_SecondItem {
    lock
    finditem(ITEM_ANTIDOTE)
    release
    end
}

script Weirford_Forest_MapScripts_ThirdItem_TM {
    lock
    finditem(ITEM_TM09)
    release
    end
}

script Weirford_Forest_MapScripts_Entrance_Sign {
    msgbox(format("Weirford Forest"), MSGBOX_SIGN)
    end
}

script Weirford_Forest_MapScripts_Exit_Sign {
    msgbox(format("<- Route 3"), MSGBOX_SIGN)
    end
}

script Weirford_Forest_MapScripts_Weirford_House {
    msgbox(format("Welcome to Weirford House"), MSGBOX_SIGN)
    end
}

script Weirford_Forest_MapScripts_HouseWarp
{
    playse(SE_DOOR)
    warpsilent(MAP_WEIRFORD_HOUSE, 7, 11)
    waitstate
    end
}

text Weirford_Forest_MapScripts_CorpoEric_TrainerPreBattle {
    format(
        "AH! Where did you come from?!"
    )
}

text Weirford_Forest_MapScripts_CorpoEric_TrainerPostBattle {
    format(
        "I'm hiding from my manager..."
    )
}

text Weirford_Forest_MapScripts_CorpoEric_TrainerDefeated {
    format(
        "I only lost because you scared me!"
    )
}

text Weirford_Forest_MapScripts_LassLila_TrainerPreBattle {
    format(
        "I'll tell you a secret if you can beat me!"
    )
}

text Weirford_Forest_MapScripts_LassLila_TrainerPostBattle {
   format("There's a house hidden deep in the forest. I heard that it's haunted...")
}

