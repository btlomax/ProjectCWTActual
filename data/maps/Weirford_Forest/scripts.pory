    format(
        "You carry no Crest, yet your Pokémon "
        "strike with unyielding weight...\p"
        "The Weirford Convent must hear of this."
    )
}

text Weirford_Forest_MapScripts_AcolyteLin_TrainerDefeated {
    format("Undisciplined, yet there is power in you...")
}

