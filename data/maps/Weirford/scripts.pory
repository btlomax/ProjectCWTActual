mapscripts Weirford_MapScripts
{
    MAP_SCRIPT_ON_TRANSITION: Weirford_MapScripts_OnTransition
}

script Weirford_MapScripts_OnTransition
{
    if (flag(FLAG_BADGE01_GET)) {
        setflag(FLAG_HIDE_WEIRFORD_JONAS_OUTSIDE)
        removeobject(LOCALID_WEIRFORD_JONAS_OUTSIDE)
    }
    else {
        clearflag(FLAG_HIDE_WEIRFORD_JONAS_OUTSIDE)
        addobject(LOCALID_WEIRFORD_JONAS_OUTSIDE)
    }

    if (flag(FLAG_WEIRFORD_ACOLYTE_LIN_APPEARS))
    {
        removeobject(LOCALID_WEIRFORD_ACOLYTE_LIN)
    }

    end
}

script Weirford_MapScripts_GreetingsSign
{
    msgbox(format("Welcome to Weirford!"), MSGBOX_SIGN)
}

script Weirford_MapScripts_GymSign
{
    msgbox(format("The text has faded away..."), MSGBOX_SIGN)
}

script Weirford_MapScripts_MartNPC
{
    lock
    faceplayer
    msgbox(format("Have you been inside that scary looking building yet?"), MSGBOX_DEFAULT)
    release
    end
}

script Weirford_MapScripts_GardenNPC
{
    lock
    faceplayer
    msgbox(format("A bit of greenery in a town is always welcome."
    "It makes everything feel fresher."), MSGBOX_DEFAULT)
    release
    end
}

script Weirford_MapScripts_AcolyteLin
{
    lock

    msgbox(format("Ah, the child from the forest, I was hoping to meet you again. After you bested me, I returned to the Convent to meditate on my defeat.\p"
    "You possess talent, certainly... but it is crude. Unrefined. A raw confidence that borders on recklessness.\p"), MSGBOX_DEFAULT)

    if(flag(FLAG_BADGE01_GET))
    {
        msgbox(format("I see that Milo handed over his badge... Could it be? The first true challenger in centuries?\p"
            "Or perhaps Milo has simply grown old and soft behind his desk, and the trial has lost whatever luster it once had.\p"
            "If the other heirs are ready, they will make themselves known soon enough. We shall see if you last that long.\p"
            "The Abbess insists on meeting you. Come up to the Convent in the north of town before you leave...though I doubt she will find much to admire."), MSGBOX_DEFAULT)
    }
    else
    {
        msgbox(format("You have not even challenged the gym yet, I see. Lingering around, wasting daylight.\p"
            "Should you somehow manage to best Milo, bring yourself up to the Convent in the north of town. The Abbess wishes to examine you herself, if only to satisfy her curiosity."), MSGBOX_DEFAULT)
    }

    applymovement(LOCALID_WEIRFORD_ACOLYTE_LIN, Weirford_Movement_AcolyteLin)
    waitmovement(LOCALID_WEIRFORD_ACOLYTE_LIN)

    setflag(FLAG_WEIRFORD_ACOLYTE_LIN_APPEARS)
    release
    end
}

script Weirford_MapScripts_BasinSign
{
    msgbox(format("The stone basin is filled with murky water after the recent storms.\p"), MSGBOX_SIGN)

    if (var(VAR_QUEST_THE_HOUSE_IN_THE_WOODS_STATE) > 0 &&
        var(VAR_QUEST_THE_HOUSE_IN_THE_WOODS_STATE) < 4 &&
        !flag(FLAG_FOUND_LOST_DOLL))
    {
        msgbox(format("You notice a water-logged bundle of cloth floating in the basin.\p"), MSGBOX_DEFAULT)
        msgbox(format("Reach in and grab it?"), MSGBOX_YESNO)

        if (var(VAR_RESULT) == YES)
        {
            msgbox(format("It's very wet and soggy, but it seems intact.\p"), MSGBOX_DEFAULT)
            giveitem(ITEM_DAMP_RAGDOLL)
            setflag(FLAG_FOUND_LOST_DOLL)
        }
        else
        {
            msgbox(format("You decide not to grab the bundle."), MSGBOX_DEFAULT)
        }
    }
}

script Weirford_MapScripts_JonasOutside
{
    lock
    msgbox(format("{FONT_NARROW}The young man before you is visibly shaking. He's clutching a tattered notebook to his chest, leaving a wet stain on his shirt.{FONT_NORMAL}"), MSGBOX_DEFAULT)
    applymovement(LOCALID_WEIRFORD_JONAS_OUTSIDE, Common_Movement_ExclamationMark)
    waitmovement(LOCALID_WEIRFORD_JONAS_OUTSIDE)
    playse(SE_PIN)
    faceplayer
    msgbox(format("AAAAH!"), MSGBOX_DEFAULT)
    msgbox(format("Oh wait, wait I'm sorry, I didn't mean to scare you!"), MSGBOX_DEFAULT)
    msgbox(format("It's just...this notebook. It was my little brother's, he went missing a couple of years ago."), MSGBOX_DEFAULT)
    msgbox(format("Wait, you're a trainer! You don't happen to know how to use CUT do you?"), MSGBOX_DEFAULT)
    msgbox(format("..."), MSGBOX_DEFAULT)
    msgbox(format("I see, please come back when you know how to use CUT."), MSGBOX_DEFAULT)
    applymovement(LOCALID_WEIRFORD_JONAS_OUTSIDE, Weirford_Movement_Jonas_Turn_Around)

    release
    end
}

movement Weirford_Movement_Jonas_Turn_Around
{
    face_up
    step_end
}

movement Weirford_Movement_AcolyteLin
{
    walk_right
    face_left
}
